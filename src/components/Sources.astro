---
/**
 * Section « Sources » de la page pilier — RECETTE-SITE.md §7.
 * Au moins trois liens vers des textes officiels ; les URL viennent du fichier de
 * paramètres, jamais codées en dur, pour rester synchronisées avec ce que le moteur
 * applique et suivre la mise à jour annuelle.
 *
 * Prérequis : src/data/params-<année>.json contient un objet `sources`
 *   { "<clé>": { "url": "...", "label": { "<lang>": "..." } } }
 * Contrôlé par scripts/check-seo.py (échec si < 3 liens officiels sur le pilier).
 */
import P from '../data/params-2026.json';
import { LANG_TAGS } from '../data/site-config';
import { displayDate } from '../lib/format';
interface Props { lang: string }
const { lang } = Astro.props;

const INTRO: Record<string, string> = {
  fr: 'Retenues ONSS, bonus à l’emploi, précompte et salaires de référence se relisent dans ces textes du SPF Finances, de l’ONSS, du CNT, de l’INASTI, de Statbel et d’Eurostat, avec après chaque lien le jour de notre dernière lecture.',
  nl: 'RSZ-inhoudingen, werkbonus, voorheffing en referentielonen zijn na te lezen in deze teksten van de FOD Financiën, de RSZ, de NAR, het RSVZ, Statbel en Eurostat, met na elke link de dag waarop wij ze het laatst lazen.',
};
const LU: Record<string, string> = { fr: 'lu le', nl: 'gelezen op' };
const AVERIFIER: Record<string, string> = {
  fr: 'à vérifier : Fisconet n’a pas pu être relu le 3 novembre 2026',
  nl: 'na te kijken: Fisconet kon op 3 november 2026 niet opnieuw worden gelezen',
};
const H2: Record<string, string> = {
  fr: 'Sources', de: 'Quellen', en: 'Sources', es: 'Fuentes',
  nl: 'Bronnen', it: 'Fonti', pt: 'Fontes', nb: 'Kilder', da: 'Kilder',
};
type Src = { url: string; label: Record<string, string>; read_on: string; status?: string };
const sources: Src[] = Object.values((P as { sources?: Record<string, Src> }).sources ?? {});
---
{sources.length > 0 && (
  <>
    <h2 id="sources">{H2[lang] ?? H2.en}</h2>
    <p>{INTRO[lang] ?? INTRO.fr}</p>
    <ul>
      {sources.map((s) => (
        <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label[lang] ?? s.label.fr}</a>, {LU[lang]} {displayDate(s.read_on, LANG_TAGS[lang])}{s.status === 'a-verifier' && <> ({AVERIFIER[lang]})</>}</li>
      ))}
    </ul>
  </>
)}
