---
/** Page « par montant » (RECETTE §6.2) : angle propre en tête, données du moteur, voisins. */
import PageLayout from '../layouts/PageLayout.astro';
import BeCalculator from './calc/BeCalculator';
import AdSlot from './AdSlot.astro';
import ContentTable from './ContentTable.astro';
import { route, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { webApplicationSchema, webPageSchema, faqSchema, breadcrumbSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { Angle } from '../lib/amount-angles';
import { fitDescription, fitTitle } from '../lib/snippet';
interface Props { lang: Locale; id: string; crumb: string; angle: Angle; gross: number; table: { caption: string; headers: string[]; rows: string[][] }; neighbours: Array<{ href: string; name: string }>; position?: { text: string; href: string; label: string }; sources: Array<{ name: string; url: string }> }
const { lang, id, crumb, angle: A, gross, table, neighbours, position, sources } = Astro.props;
const ui = t(lang); const path = route(id, lang);
const title = fitTitle(A.title, lang); const description = fitDescription(A.description, lang);
const jsonLd = [webApplicationSchema({ name: A.h1, description, path, lang }), webPageSchema({ name: A.h1, description, path, lang }), faqSchema(A.faqs, lang), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: crumb, path }])];
const note = lang === 'fr'
  ? 'Montants calculés avec la formule-clé du précompte professionnel 2026, l’ONSS à 13,07 % et le bonus à l’emploi applicable depuis le 1er septembre 2026, pour un employé à temps plein. Estimation : votre fiche de paie fait foi.'
  : 'Bedragen berekend met de sleutelformule voor de bedrijfsvoorheffing 2026, de RSZ van 13,07 % en de werkbonus die sinds 1 september 2026 geldt, voor een voltijdse bediende. Schatting: je loonfiche is bepalend.';
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={A.faqs} breadcrumbs={[{ label: crumb }]} related={neighbours.map((n) => ({ ...n, description: '' }))} sources={sources}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{A.h1}</h1>
    <p class="mt-2 text-sm text-navy-500">{ui.reviewedBy} <a href={route('about', lang)} class="text-accent-700 hover:underline">{AUTHOR_NAME}</a></p>
  </header>
  <section class="prose prose-slate max-w-none">
    <h2>{A.h2}</h2>
    <p>{A.p}</p>
  </section>
  <BeCalculator client:load mode="brutNet" lang={lang} initialGross={gross} methodHref={route('method', lang)} />
  <AdSlot slot={`${id}-1`} />
  <section class="prose prose-slate max-w-none">
    <h2>{A.h2b}</h2>
    <p>{A.p2}</p>
    <h2>{table.caption}</h2>
    <ContentTable headers={table.headers} align={table.headers.map((_, i) => (i === 0 ? 'l' : 'r'))} rows={table.rows} />
    <p data-chrome>{note}</p>
    {position && <p data-chrome>{position.text} <a href={position.href}>{position.label}</a>.</p>}
    <nav data-chrome aria-label={lang === 'fr' ? 'Salaires proches' : 'Lonen in de buurt'}><p class="text-sm">{lang === 'fr' ? 'À proximité' : 'In de buurt'} : {neighbours.slice(0, 4).map((n, i) => <>{i > 0 && ' · '}<a href={n.href}>{n.name}</a></>)}</p></nav>
  </section>
</PageLayout>
