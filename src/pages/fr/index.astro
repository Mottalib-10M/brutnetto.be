---
import PageLayout from '../../layouts/PageLayout.astro';
import BeCalculator from '../../components/calc/BeCalculator';
import ContentTable from '../../components/ContentTable.astro';
import Sources from '../../components/Sources.astro';
import { YEAR, LAST_UPDATED, AUTHOR_NAME, LANG_TAGS } from '../../data/site-config';
import { route, MONTHLY } from '../../i18n/routes';
import { monthlyLabel, label } from '../../i18n/nav';
import { webApplicationSchema, faqSchema, breadcrumbSchema, organizationSchema, personSchema, websiteSchema } from '../../lib/seo';
import { ex, P } from '../../lib/tables';
import { employerCost, doublePecule, yearEndBonus, grossForNet } from '../../lib/engine/be';
import { fmt, displayDate } from '../../lib/format';
import { src } from '../../lib/sources';
const lang = 'fr'; const f = fmt(lang); const S = src(lang);
const title = `Salaire brut en net Belgique 2026 : calcul du salaire net`;
const description = `Calculez votre salaire net en Belgique pour 2026 : ONSS de 13,07 %, bonus à l’emploi, précompte selon la formule-clé et cotisation spéciale. Gratuit et anonyme.`;
const g = 3500; const r = ex(g); const E = P.bonus.employe;
const fam = [['Isolé', ex(g)], ['Isolé, 1 enfant', ex(g, { children: 1 })], ['Isolé, 2 enfants', ex(g, { children: 2 })], ['Parent isolé, 2 enfants', ex(g, { children: 2, parentIsole: true })], ['Conjoint avec revenus', ex(g, { situation: 'conjoint_revenus' })], ['Conjoint sans revenus', ex(g, { situation: 'conjoint_sans' })]].map(([l, x]: any) => [l, f.money(x.pp, 0), f.money(x.csss, 0), f.money(x.net, 0)]);
const faqs = [
  { q: 'Comment calculer son salaire net en Belgique ?', a: `Du salaire brut, retirez la cotisation ONSS de 13,07 % diminuée du bonus à l’emploi, puis le précompte professionnel calculé avec la formule-clé du SPF Finances, et enfin la cotisation spéciale de sécurité sociale. Pour ${f.money(g, 0)} brut, un employé isolé reçoit ${f.money(r.net, 0)} net par mois en 2026.` },
  { q: 'Quel pourcentage du brut reste en net ?', a: `Entre 55 et 95 % selon le salaire et la situation familiale. Au salaire minimum, le bonus à l’emploi laisse plus de 90 % du brut ; à ${f.money(g, 0)}, il reste ${f.pct(r.net / g, 1)} pour un isolé ; au-delà de 6 000 €, moins de 60 %. Les enfants à charge et un conjoint sans revenus augmentent le net.` },
  { q: 'Le calculateur tient-il compte des changements de 2026 ?', a: `Oui. Il applique la formule-clé du précompte pour les rémunérations payées depuis le 1er janvier 2026, les montants du bonus à l’emploi en vigueur depuis le 1er septembre 2026 et le salaire minimum de ${f.money(P.rmmmg.amount, 2)} du 1er avril 2026. Chaque source porte sa date de lecture en bas de page.` },
  { q: 'Quelle différence entre employé et ouvrier ?', a: 'Pour un ouvrier, la cotisation ONSS est calculée sur 108 % du salaire brut, parce que son pécule de vacances est payé par une caisse de vacances. Le bonus à l’emploi est aussi plus élevé. À salaire brut égal, le net mensuel d’un ouvrier est donc un peu plus bas, mais son pécule est versé séparément.' },
  { q: 'Pourquoi une augmentation rapporte-t-elle parfois très peu ?', a: `Entre ${f.money(E.b_from, 0)} et ${f.money(E.a_to, 0)} brut, le bonus à l’emploi diminue quand le salaire augmente. La perte de bonus s’ajoute au précompte, si bien que 100 € brut de plus peuvent ne rapporter qu’une vingtaine d’euros net dans la zone du volet B. Au-delà, une augmentation rapporte de 40 à 44 % en net.` },
  { q: 'Le précompte professionnel est-il l’impôt définitif ?', a: 'Non, c’est une avance. L’impôt définitif est calculé après la déclaration fiscale, avec la taxe communale réelle, les réductions d’impôt et les revenus du ménage. La différence avec le précompte retenu donne un remboursement ou un supplément dans l’avertissement-extrait de rôle.' },
  { q: 'Mes données sont-elles enregistrées ?', a: 'Non. Le calcul se fait entièrement dans votre navigateur, avec les paramètres 2026 intégrés à la page. Rien de ce que vous saisissez n’est envoyé ni conservé. Le lien de partage, si vous l’utilisez, contient les montants dans l’adresse, visible seulement par ceux à qui vous l’envoyez.' },
];
const paliers = [2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 4000, 5000].map((x) => { const d = ex(x + 100).net - ex(x).net; return [f.money(x, 0), f.money(ex(x).net, 0), f.money(d, 0), f.pct(d / 100, 0)]; });
const statuts = [2500, 3500, 5000].map((x) => { const e = ex(x); const o = ex(x, { status: 'ouvrier' }); return [f.money(x, 0), f.money(e.onssNet, 0), f.money(o.onssNet, 0), f.money(e.net, 0), f.money(o.net, 0)]; });
const brutTable = MONTHLY.map((x) => { const a = ex(x); return { x, href: route(`m-${x}`, lang), label: monthlyLabel(x, lang), onss: f.money(a.onssNet, 0), pp: f.money(a.pp, 0), net: f.money(a.net, 0), part: f.pct(a.net / x, 0) }; });
const dp = doublePecule({ gross: g }); const yb = yearEndBonus({ gross: g }); const ec = employerCost(g);
const jsonLd = [webApplicationSchema({ name: `Calcul salaire brut net ${YEAR}`, description, path: route('home', lang), lang }), faqSchema(faqs, lang), breadcrumbSchema([{ name: 'Accueil', path: route('home', lang) }]), organizationSchema(lang), personSchema(lang), websiteSchema(lang)];
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Salaire brut en net {YEAR} : calculez votre salaire net en Belgique</h1>
    <p class="mt-3 text-lg text-navy-600">Salaire brut, statut, situation familiale : vous voyez aussitôt l’ONSS, le bonus à l’emploi, le précompte, la cotisation spéciale et le net, comme sur une fiche de paie belge.</p>
    <p class="mt-3"><span class="inline-block rounded-full border border-navy-200 bg-white px-3 py-1 text-xs font-medium text-navy-600">Formule-clé SPF Finances {YEAR}</span></p>
  </header>
  <BeCalculator client:load mode="brutNet" lang={lang} methodHref={route('method', lang)} />
  <section class="prose prose-slate mt-8 max-w-none">
    <h2 id="reponse">Ce qui reste de {f.money(g, 0)} brut par mois</h2>
    <p>Pour un employé isolé sans enfant payé {f.money(g, 0)} brut par mois en 2026, la cotisation personnelle de sécurité sociale de 13,07 % retire {f.money(r.onss, 0)}. À ce niveau, le bonus à l’emploi ne joue plus : il s’arrête à {f.money(E.a_to, 2)}. La rémunération imposable est donc de {f.money(r.imposable, 0)}. Le précompte professionnel, calculé avec la formule-clé du SPF Finances, s’élève à {f.money(r.pp, 0)}. La cotisation spéciale de sécurité sociale ajoute {f.money(r.csss, 0)}. Le salaire net est de {f.money(r.net, 0)}, soit {f.pct(r.net / g, 1)} du brut. Avec un conjoint sans revenus professionnels, le quotient conjugal fait monter le net à {f.money(ex(g, { situation: 'conjoint_sans' }).net, 0)}, et avec deux enfants à charge, il atteint {f.money(ex(g, { children: 2 }).net, 0)}. De son côté, l’employeur paie environ {f.money(ec.monthly, 0)} par mois, cotisations patronales comprises. Une fois par an s’ajoutent le double pécule de vacances, {f.money(dp.net, 0)} net, et, dans la plupart des secteurs, un treizième mois de {f.money(yb.net, 0)} net.</p>
  </section>

  <figure class="mt-8" id="fiche">
    <figcaption class="mb-2 text-lg font-semibold text-navy-900">La fiche de paie de {f.money(g, 0)} brut, ligne par ligne</figcaption>
    <div class="overflow-x-auto"><table class="journal w-full text-sm">
      <thead><tr><th scope="col" class="px-3 py-2 text-left">Ligne</th><th scope="col" class="px-3 py-2 text-right">Montant</th><th scope="col" class="px-3 py-2 text-left">D’où vient-elle</th></tr></thead>
      <tbody class="divide-y divide-navy-100 text-navy-700">
        <tr><td class="px-3 py-2">Salaire brut</td><td class="tabular-nums px-3 py-2 text-right">{f.money(g, 0)}</td><td class="px-3 py-2">Salaire de base, primes, heures supplémentaires et avantages soumis à l’ONSS.</td></tr>
        <tr><td class="px-3 py-2">Cotisation ONSS</td><td class="tabular-nums px-3 py-2 text-right">− {f.money(r.onss, 0)}</td><td class="px-3 py-2">13,07 % du brut pour un employé, de 108 % du brut pour un ouvrier : <a class="underline" href={route('onss', lang)}>cotisations ONSS</a>.</td></tr>
        <tr><td class="px-3 py-2">Bonus à l’emploi</td><td class="tabular-nums px-3 py-2 text-right">{f.money(r.bonus, 0)}</td><td class="px-3 py-2">Volets A et B, jusqu’à {f.money(E.a_to, 2)} brut, plafonnés à la cotisation due : <a class="underline" href={route('bonus', lang)}>bonus à l’emploi</a>.</td></tr>
        <tr><td class="px-3 py-2">Rémunération imposable</td><td class="tabular-nums px-3 py-2 text-right">{f.money(r.imposable, 0)}</td><td class="px-3 py-2">Le brut moins l’ONSS réellement retenu.</td></tr>
        <tr><td class="px-3 py-2">Précompte professionnel</td><td class="tabular-nums px-3 py-2 text-right">− {f.money(r.pp, 0)}</td><td class="px-3 py-2">Formule-clé : annualisation, frais forfaitaires, barème de 26,75 à 53,50 %, quotité exemptée, charges de famille : <a class="underline" href={route('pp', lang)}>précompte professionnel</a>.</td></tr>
        <tr><td class="px-3 py-2">Cotisation spéciale</td><td class="tabular-nums px-3 py-2 text-right">− {f.money(r.csss, 0)}</td><td class="px-3 py-2">Retenue mensuelle selon le salaire et le ménage : <a class="underline" href={route('csss', lang)}>cotisation spéciale de sécurité sociale</a>.</td></tr>
        <tr class="font-semibold text-navy-900"><td class="px-3 py-2">Salaire net</td><td class="tabular-nums px-3 py-2 text-right">{f.money(r.net, 0)}</td><td class="px-3 py-2">Hors chèques-repas, indemnités de frais et avantages en nature.</td></tr>
      </tbody>
    </table></div>
  </figure>

  <article class="prose prose-slate mt-8 max-w-none" id="trappe">
    <h2>La zone où 100 € brut de plus rapportent peu</h2>
    <p>C’est la particularité belge que la plupart des calculateurs ne montrent pas. Entre {f.money(E.b_from, 0)} et {f.money(E.a_to, 0)} brut, le bonus à l’emploi fond à mesure que le salaire monte : la perte de bonus s’ajoute au précompte. Une augmentation négociée dans cette zone se lit donc en net, pas en brut.</p>
    <figure>
      <ContentTable caption="Employé isolé sans enfant, gain net d’une hausse de 100 € brut par mois" headers={['Brut actuel', 'Net actuel', 'Gain net pour 100 € brut', 'Part conservée']} align={['r', 'r', 'r', 'r']} rows={paliers} />
    </figure>
    <p>Au-delà de {f.money(E.a_to, 0)}, le bonus a disparu et la part conservée remonte, avant de redescendre avec la tranche suivante du barème.</p>
  </article>

  <article class="prose prose-slate mt-8 max-w-none" id="statut">
    <h2>Employé ou ouvrier, à brut égal</h2>
    <p>L’ouvrier cotise sur 108 % de son brut, car son pécule de vacances vient d’une caisse de vacances et non de l’employeur. Son bonus à l’emploi est plus élevé, mais son net mensuel reste un peu plus bas. La comparaison ne s’arrête pas là : l’employé reçoit son double pécule de l’employeur, l’ouvrier le reçoit séparément, une fois par an, de la caisse.</p>
    <ContentTable headers={['Brut', 'ONSS employé', 'ONSS ouvrier', 'Net employé', 'Net ouvrier']} align={['r', 'r', 'r', 'r', 'r']} rows={statuts} />
  </article>

  <section class="prose prose-slate mt-8 max-w-none" id="salaires">
    <h2>Votre salaire en net, de {f.money(MONTHLY[0], 0)} à {f.money(MONTHLY[MONTHLY.length - 1], 0)} brut</h2>
    <p>Chaque salaire renvoie à sa page, qui explique le seuil qui compte à ce niveau : bonus à l’emploi, cotisation spéciale, quotient conjugal, enfants, pécule de vacances, treizième mois ou tranche la plus élevée. La part du brut qui reste en net diminue avec le salaire.</p>
    <div class="overflow-x-auto"><table class="w-full text-sm">
      <thead><tr><th scope="col" class="text-left">Salaire</th><th scope="col" class="text-right">ONSS après bonus</th><th scope="col" class="text-right">Précompte</th><th scope="col" class="text-right">Net</th><th scope="col" class="text-right">Net / brut</th></tr></thead>
      <tbody>{brutTable.map((l) => <tr><td><a href={l.href}>{l.label}</a></td><td class="tabular-nums text-right">{l.onss}</td><td class="tabular-nums text-right">{l.pp}</td><td class="tabular-nums text-right">{l.net}</td><td class="tabular-nums text-right">{l.part}</td></tr>)}</tbody>
    </table></div>

    <h2 id="famille">Selon la situation familiale, {f.money(g, 0)} brut</h2>
    <ContentTable headers={['Situation', 'Précompte', 'Cotisation spéciale', 'Net']} align={['l', 'r', 'r', 'r']} rows={fam} />
    <p>Chaque enfant à charge diminue l’impôt annuel d’un montant fixe, et le parent isolé reçoit une réduction supplémentaire. Le quotient conjugal attribue au conjoint sans revenus 30 % du revenu imposable, au maximum {f.money(P.pp.conjoint_max, 0)} par an. Lorsque le conjoint a des revenus, la cotisation spéciale suit le barème des ménages à deux revenus.</p>

    <h2 id="annuel">Sur une année complète</h2>
    <p>Un employé ne reçoit pas seulement douze salaires. Le double pécule de vacances, égal à 92 % du brut mensuel, est versé une fois par an avec un précompte à taux fixe, et la plupart des commissions paritaires prévoient une prime de fin d’année d’un mois de salaire. Pour {f.money(g, 0)} brut, le total net de l’année approche {f.money(r.net * 12 + dp.net + yb.net, 0)}. Les calculateurs du <a href={route('pecule', lang)}>pécule de vacances</a> et de la <a href={route('prime', lang)}>prime de fin d’année</a> détaillent ces montants. Pour savoir quel brut demander pour un net donné, le <a href={route('netBrut', lang)}>calcul du net au brut</a> fait la recherche inverse ; il faut par exemple {f.money(grossForNet(2800), 0)} brut pour toucher 2 800 € net en tant qu’isolé.</p>

    <h2 id="employeur">Ce que coûte le salaire à l’employeur</h2>
    <p>L’employeur paie en plus du brut une cotisation patronale de base et une modération salariale, environ 25 % au total pour un employé du secteur privé. Un salaire de {f.money(g, 0)} coûte ainsi {f.money(ec.monthly, 0)} par mois et environ {f.money(ec.annual, 0)} par an avec treizième mois et double pécule. La réduction structurelle diminue ce coût pour les bas et moyens salaires. Le <a href={route('cout', lang)}>calculateur de coût employeur</a> donne le détail.</p>
  </section>

  <aside class="prose prose-slate mt-8 max-w-none rounded-lg border-l-4 border-accent-500 bg-navy-50 px-5 py-1" id="parametres">
    <h2 class="!border-0">Paramètres {YEAR}</h2>
    <ContentTable headers={['Paramètre', 'Valeur']} align={['l', 'r']} rows={[
      ['Cotisation ONSS personnelle', '13,07 % (ouvriers : sur 108 %)'],
      ['Bonus à l’emploi, volet A (employé)', `${f.money(E.a_max, 2)} jusqu’à ${f.money(E.a_from, 2)}, nul à ${f.money(E.a_to, 2)}`],
      ['Bonus à l’emploi, volet B (employé)', `${f.money(E.b_max, 2)} jusqu’à ${f.money(E.b_from, 2)}, nul à ${f.money(E.b_to, 2)}`],
      ['Frais professionnels forfaitaires (précompte)', `30 %, maximum ${f.money(P.pp.frais_max, 0)} par an`],
      ['Barème du précompte', '26,75 % à 53,50 % (7 % de taxe communale inclus)'],
      ['Quotité exemptée (précompte)', `${f.money(P.pp.quotite, 0)}`],
      ['Cotisation spéciale, maximum mensuel', `${f.money(P.csss.max_single, 2)} (isolé ou conjoint sans revenus) · ${f.money(P.csss.max_two, 2)} (conjoint avec revenus)`],
      ['Salaire minimum (RMMMG) depuis le 1er avril 2026', f.money(P.rmmmg.amount, 2)],
    ]} />
  </aside>

  <section class="prose prose-slate mt-8 max-w-none">
    <h2 id="conseils">Six points à vérifier sur votre fiche de paie</h2>
    <ol>
      <li><strong>Le statut.</strong> Employé ou ouvrier change la base ONSS et le bonus à l’emploi.</li>
      <li><strong>La situation familiale déclarée.</strong> Enfants à charge, conjoint avec ou sans revenus : une erreur modifie le précompte chaque mois.</li>
      <li><strong>Le bonus à l’emploi.</strong> Sous {f.money(E.a_to, 0)} brut à temps plein, il doit apparaître sur la fiche de paie.</li>
      <li><strong>La cotisation spéciale.</strong> Son montant dépend de la situation du ménage ; elle est régularisée dans l’avertissement-extrait de rôle.</li>
      <li><strong>Les avantages non soumis.</strong> Chèques-repas et indemnités de frais augmentent le net sans passer par l’ONSS.</li>
      <li><strong>Le décompte fiscal.</strong> Le précompte est une avance ; vérifiez chaque année l’avertissement-extrait de rôle.</li>
    </ol>

    <h2 id="limites">Ce que le calculateur ne couvre pas</h2>
    <p>Le calcul suppose un temps plein et un salaire constant. Il ne tient pas compte des avantages en nature comme la voiture de société, des chèques-repas, des heures supplémentaires avec réduction de précompte, des régimes particuliers comme les flexi-jobs, les étudiants ou les dirigeants d’entreprise, ni des réductions fiscales accordées dans la déclaration. Pour un temps partiel, le bonus à l’emploi est proratisé, ce qui peut modifier légèrement le net. La <a href={route('method', lang)}>méthodologie</a> décrit toutes les règles appliquées et les tests qui les vérifient.</p>

    <h2 id="impot">Du précompte à l’impôt final</h2>
    <p>Le précompte retenu chaque mois est une estimation de l’impôt sur le salaire. L’impôt définitif, calculé l’année suivante, utilise les <a href={route('baremes', lang)}>barèmes de l’impôt</a> de 25 à 50 %, la taxe communale réelle de votre commune et toutes vos réductions d’impôt. Pour la plupart des salariés sans autres revenus, la différence est modeste. Elle peut être plus importante en cas de changement de situation en cours d’année, de revenus du conjoint ou de dépenses donnant droit à une réduction, comme l’épargne-pension ou les titres-services.</p>

    <h2 id="outils">Les autres calculs du site</h2>
    <p data-chrome><a href={route('brutNet', lang)}>{label('brutNet', lang)}</a> · <a href={route('pp', lang)}>{label('pp', lang)}</a> · <a href={route('netBrut', lang)}>{label('netBrut', lang)}</a> · <a href={route('horaire', lang)}>{label('horaire', lang)}</a> · <a href={route('pecule', lang)}>{label('pecule', lang)}</a> · <a href={route('prime', lang)}>{label('prime', lang)}</a> · <a href={route('cout', lang)}>{label('cout', lang)}</a> · <a href={route('independant', lang)}>{label('independant', lang)}</a> · <a href={route('baremes', lang)}>{label('baremes', lang)}</a> · <a href={route('minimum', lang)}>{label('minimum', lang)}</a> · <a href={route('moyen', lang)}>{label('moyen', lang)}</a></p>
    <Sources lang={lang} />
  </section>
</PageLayout>
