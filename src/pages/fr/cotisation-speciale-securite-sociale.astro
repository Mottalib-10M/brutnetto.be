---
import MiniSim from '../../components/calc/MiniSim';
import Guide from '../../components/Guide.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { csss } from '../../lib/engine/be';
import { P } from '../../lib/tables';
import { src } from '../../lib/sources';
import { fmt } from '../../lib/format';
const lang = 'fr'; const f = fmt(lang); const S = src(lang);
const C = P.csss;
const I = C.isole; const J = C.commun; const m2 = (x: number) => f.money(x, 2); const p2 = (x: number) => f.pct(x, 2);
const commun = (mx: number) => `${m2(J.base2)} + ${p2(J.rate2)} au-delà de ${m2(C.t2)}, maximum ${m2(mx)}`;
const bar = [
  [`moins de ${m2(C.t0)}`, m2(0), m2(0), m2(0)],
  [`${m2(C.t0)} à ${m2(C.t1)}`, m2(0), m2(0), m2(C.two_income_flat)],
  [`${m2(C.t1 + 0.01)} à ${m2(C.t2)}`, `${p2(I.rate1)} au-delà de ${m2(C.t1)}`, `${p2(J.rate1)} au-delà de ${m2(C.t1)}`, `${p2(J.rate1)} au-delà de ${m2(C.t1)}, minimum ${m2(C.two_income_flat)}`],
  [`${m2(C.t2 + 0.01)} à ${m2(I.t_a)}`, `${m2(I.base2)} + ${p2(I.rate2)} au-delà de ${m2(C.t2)}`, commun(C.max_sans), commun(C.max_two)],
  [`${m2(I.t_a + 0.01)} à ${m2(I.t_b)}`, `${m2(I.base3)} + ${p2(I.rate3)} au-delà de ${m2(I.t_a)}`, commun(C.max_sans), commun(C.max_two)],
  [`${m2(I.t_b + 0.01)} à ${m2(C.t3)}`, `${m2(I.base4)} + ${p2(I.rate4)} au-delà de ${m2(I.t_b)}`, commun(C.max_sans), commun(C.max_two)],
  [`au-delà de ${m2(C.t3)}`, m2(C.max_single), commun(C.max_sans), m2(C.max_two)],
];
const ex = [1500, 2100, 2500, 3500, 4500, 6000, 8000].map((g) => [f.money(g, 0), m2(csss(g, 'isole')), m2(csss(g, 'conjoint_sans')), m2(csss(g, 'conjoint_revenus'))]);
const faqs = [
  { q: 'Qu’est-ce que la cotisation spéciale de sécurité sociale ?', a: 'C’est une cotisation créée en 1994 pour contribuer au financement de la sécurité sociale, due par les ménages selon leurs revenus. Pour les salariés, elle est retenue chaque mois par l’employeur, puis régularisée par l’administration fiscale au moment de l’avertissement-extrait de rôle.' },
  { q: 'Pourquoi dépend-elle de la situation du ménage ?', a: `Parce que la cotisation annuelle définitive est calculée sur les revenus du ménage. Depuis le 1er avril 2022, le barème des retenues distingue l’imposition individuelle de l’imposition commune. Un conjoint avec revenus paie dès ${m2(C.t0)} brut, là où un isolé ou un conjoint sans revenus ne paie rien jusqu’à ${m2(C.t1)}, mais son plafond mensuel est plus bas.` },
  { q: 'Quel est le montant maximum de la cotisation spéciale ?', a: `La retenue mensuelle est plafonnée à ${m2(C.max_single)} pour un isolé ou un conjoint sans revenus, et à ${m2(C.max_two)} pour un conjoint avec revenus. La cotisation annuelle définitive a son propre plafond, calculé sur les revenus nets imposables du ménage.` },
  { q: 'Pourquoi dois-je parfois un supplément de cotisation spéciale ?', a: 'Les retenues mensuelles ne connaissent pas les revenus de l’autre conjoint ni les autres revenus du ménage. Si le montant annuel calculé sur le revenu net imposable du ménage dépasse les retenues, la différence est ajoutée à l’impôt dans l’avertissement-extrait de rôle.' },
  { q: 'La cotisation spéciale est-elle déductible ?', a: 'Non. Contrairement à la cotisation ONSS ordinaire, elle n’est pas déduite de la rémunération imposable. Elle est retenue en plus du précompte professionnel et n’a pas d’effet sur le calcul de l’impôt. Elle apparaît sur une ligne séparée de la fiche de paie.' },
  { q: 'La cotisation spéciale change-t-elle en 2026 ?', a: 'Le barème des retenues mensuelles n’est pas indexé chaque année : les instructions de l’ONSS pour 2026 reprennent les montants entrés en vigueur le 1er avril 2022. Le calculateur applique les seuils en vigueur à la date de vérification. Si le législateur modifie le barème, les nouveaux montants seront intégrés et la date de mise à jour de la page changera.' },
];
---
<Guide lang={lang} id="csss" title="Cotisation spéciale de sécurité sociale 2026 : barème" h1="Cotisation spéciale de sécurité sociale : barème des retenues mensuelles"
  description="La cotisation spéciale de sécurité sociale en 2026 : barème des retenues mensuelles pour isolés et ménages à deux revenus, plafonds et régularisation annuelle."
  intro="La cotisation spéciale de sécurité sociale est la troisième retenue de la fiche de paie, après l’ONSS et le précompte. Voici comment elle est calculée."
  resume={`La cotisation spéciale de sécurité sociale est une contribution supplémentaire au financement de la sécurité sociale, introduite en 1994 et due par les ménages en fonction de leurs revenus. Pour les travailleurs salariés, l’employeur la retient chaque mois sur le salaire selon un barème qui dépend du salaire brut et de la situation du ménage. Rien n’est retenu jusqu’à ${m2(C.t1)} par mois pour un isolé ou un conjoint sans revenus ; un conjoint avec revenus paie dès ${m2(C.t0)}. Ensuite, le montant augmente par paliers pour atteindre un maximum de ${m2(C.max_single)} par mois pour un isolé ou un conjoint sans revenus, et de ${m2(C.max_two)} pour un conjoint avec revenus. Sur un salaire de ${f.money(3500, 0)}, un isolé paie ${m2(csss(3500, 'isole'))} par mois. Ces retenues sont une avance : la cotisation annuelle définitive est calculée par l’administration fiscale sur le revenu net imposable du ménage et régularisée dans l’avertissement-extrait de rôle, ce qui peut conduire à un supplément ou à un remboursement.`}
  faqs={faqs} related={['brutNet', 'onss', 'pp', 'baremes', 'home', 'netBrut']} sources={[S.csss, S.onss, S.formule]}>
  <MiniSim client:visible kind="csss" lang={lang} href={route('brutNet', lang)} />
  <h2>Barème des retenues mensuelles</h2>
  <ContentTable headers={['Salaire brut mensuel', 'Isolé', 'Conjoint sans revenus', 'Conjoint avec revenus']} align={['l', 'l', 'l', 'l']} rows={bar} />
  <p>Ce barème est en vigueur depuis le 1er avril 2022. Les montants correspondent aux montants trimestriels publiés par l’ONSS, divisés par trois. Le calculateur applique le barème au salaire brut du mois, porté à 108 % pour un ouvrier, sans le double pécule de vacances.</p>

  <h2>Exemples de retenues</h2>
  <ContentTable headers={['Salaire brut', 'Isolé', 'Conjoint sans revenus', 'Conjoint avec revenus']} align={['r', 'r', 'r', 'r']} rows={ex} />

  <h2>Retenue mensuelle et cotisation annuelle</h2>
  <p>La retenue mensuelle ne tient compte que du salaire payé par l’employeur et d’une indication sur la situation du ménage. La cotisation annuelle définitive, elle, est calculée sur le revenu net imposable global du ménage : salaires des deux conjoints, revenus de remplacement et autres revenus professionnels. Elle suit un barème annuel progressif, avec un plafond. L’administration fiscale compare ce montant aux retenues de l’année et régularise la différence dans l’avertissement-extrait de rôle. Pour un ménage à deux revenus élevés, il est fréquent qu’un petit supplément soit dû.</p>

  <h2>Situation du ménage déclarée à l’employeur</h2>
  <p>L’employeur applique le barème de l’imposition individuelle au travailleur isolé, et celui de l’imposition commune au travailleur marié ou cohabitant légal, avec un montant différent selon que son conjoint a ou non des revenus professionnels. Il est donc important de signaler un changement de situation familiale au service du personnel. Une erreur n’a pas de conséquence définitive, puisque la régularisation annuelle corrige le montant, mais elle peut entraîner un supplément à payer.</p>

  <h2>Place dans le calcul du net</h2>
  <p>La cotisation spéciale est retenue après l’ONSS et le précompte, et elle n’est pas déductible. Son poids reste modeste : environ 1 % du brut au plus, et moins sur les bas salaires. Elle explique néanmoins une partie de l’écart entre un calcul simplifié et une fiche de paie réelle. Le <a href={route('brutNet', lang)}>calcul brut net</a> l’intègre automatiquement, avec le choix de la situation familiale.</p>

  <h2>Qui en est exonéré</h2>
  <p>Les retenues ne concernent que les revenus professionnels au-delà du premier seuil. Les étudiants sous contrat d’étudiant et les bénéficiaires de certains régimes particuliers ne sont pas soumis aux retenues mensuelles. Pour les revenus de remplacement, comme les pensions ou les allocations de chômage, la cotisation est établie lors de la régularisation annuelle, selon les revenus du ménage. Les indépendants, eux, paient la cotisation spéciale uniquement via l’avertissement-extrait de rôle.</p>
  <h2>Un exemple de régularisation</h2>
  <p>Prenons un couple marié où chacun gagne {f.money(3500, 0)} brut par mois. L’employeur de chacun retient la cotisation au barème du conjoint avec revenus, soit {m2(csss(3500, 'conjoint_revenus'))} par mois et par personne. Lors du calcul annuel, l’administration additionne les revenus nets imposables du ménage et applique le barème annuel. Si le total dû dépasse la somme des retenues, un supplément apparaît dans l’avertissement-extrait de rôle ; dans le cas inverse, la différence est remboursée. Pour un isolé qui n’a qu’un salaire, les retenues mensuelles sont en général proches du montant définitif.</p>

  <h2>Pourquoi cette cotisation existe</h2>
  <p>La cotisation spéciale a été instaurée pour contribuer à l’équilibre financier de la sécurité sociale, en complément des cotisations ordinaires. Elle est progressive, car elle dépend des revenus du ménage, mais reste plafonnée. Elle est perçue par l’administration fiscale en même temps que l’impôt, ce qui explique sa régularisation via l’avertissement-extrait de rôle plutôt que par l’ONSS.</p>
</Guide>
