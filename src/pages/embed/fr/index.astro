---
/** Page embarquable (iframe) : calculateur nu, lien de crédit visible (RECETTE §13). */
import '../../../styles/global.css';
import BeCalculator from '../../../components/calc/BeCalculator';
import { SITE_URL } from '../../../data/site-config';
---
<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculateur de salaire brut en net, Belgique, widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/fr/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <BeCalculator client:load lang="fr" />
    <p class="mt-2 text-center text-xs text-navy-500"><a href={`${SITE_URL}/fr/`} target="_blank" rel="noopener" class="hover:underline">brutnetto.be</a></p>
  </body>
</html>
